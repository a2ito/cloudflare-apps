{
  "name": "account-book",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "db:migrate:remote": "wrangler d1 migrations apply account-book-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply account-book-db --local",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "drizzle:generate": "drizzle-kit generate --config=./drizzle.config.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "npm run db:migrate:remote && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^1.41.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.6.0",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "wrangler": "^4.129.0"
  }
}
