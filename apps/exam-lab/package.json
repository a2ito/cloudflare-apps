{
  "name": "exam-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "drizzle:generate": "drizzle-kit generate --config=./drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply exam-lab-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply exam-lab-db --remote",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "npm run db:migrate:remote && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.15.1",
    "@react-oauth/google": "^0.13.4",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.1.3",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "wrangler": "^4.63.0"
  }
}
