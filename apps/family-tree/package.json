{
  "name": "family-tree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "vite preview --port 3000",
    "lint": "eslint .",
    "cf-typegen": "cf workers types",
    "typecheck": "cf workers types && vinext typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node ../../scripts/d1-migrate.mjs --local",
    "db:migrate:remote": "node ../../scripts/d1-migrate.mjs --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:check-env": "node ../../scripts/check-cf-env.mjs D1_DATABASE_ID APP_HOSTNAME",
    "cf:build": "npm run cf:check-env && vite build",
    "cf:deploy": "npm run cf:check-env && npm run db:migrate:remote && vinext-cloudflare deploy --skip-build"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@vinext/cloudflare": "^1.3.4",
    "@xyflow/react": "^12.12.1",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.2",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.5",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.17",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.32",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "miniflare": "^5.20261006.1-alpha",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  }
}
