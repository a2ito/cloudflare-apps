{
  "name": "planning-porker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "vite preview --port 3000",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "drizzle:generate": "drizzle-kit generate --config=./drizzle.config.ts",
    "cf-typegen": "cf workers types",
    "typecheck": "cf workers types && vinext typegen && tsc --noEmit",
    "db:migrate:local": "node ../../scripts/d1-migrate.mjs --local --dir drizzle/migrations",
    "db:migrate:remote": "D1_DATABASE_ID=${D1_DATABASE_ID:-a2a11d45-42af-4788-a1e5-8a1bef409137} node ../../scripts/d1-migrate.mjs --remote --dir drizzle/migrations",
    "cf:build": "vite build",
    "cf:deploy": "npm run db:migrate:remote && vinext-cloudflare deploy --skip-build"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.3.4",
    "drizzle-orm": "^0.45.1",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.17",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.32",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "vite": "^8.3.8"
  }
}
