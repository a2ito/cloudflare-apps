# dependencies
/node_modules

# next.js
/.next/
/out/

# vinext / cf（ビルド出力、生成した型、ローカルの模擬 D1 などの状態）
/dist/
.vinext/
.cloudflare/

# ローカルの secret（雛形のみ共有する）
.dev.vars*
!.dev.vars.example

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# env
.env*.local

# Next.js が自動生成する AI エージェント向けルール
AGENTS.md
CLAUDE.md
# 手で書いたエージェント向けの約束は共有する（自動生成と場所を分けている）
!.claude/CLAUDE.md
# 手元だけの設定は共有しない
.claude/settings.local.json

# 旧 OpenNext / wrangler の生成物（手元に残っていても拾わない）
/.open-next/
.wrangler/
wrangler.jsonc
cloudflare-env.d.ts
