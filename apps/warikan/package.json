    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  }
}
