    "esbuild": "0.28.2",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.17",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.17",
