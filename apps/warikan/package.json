  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "vite preview --port 3000",
    "lint": "tsc --noEmit",
    "cf-typegen": "cf workers types",
    "typecheck": "cf workers types && vinext typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node ../../scripts/d1-migrate.mjs --local --dir migrations",
    "db:migrate:remote": "node ../../scripts/d1-migrate.mjs --remote --dir migrations",
    "cf:check-env": "node ../../scripts/check-cf-env.mjs D1_DATABASE_ID APP_HOSTNAME",
    "cf:build": "npm run cf:check-env && vite build",
    "cf:deploy": "npm run cf:check-env && npm run db:migrate:remote && vinext-cloudflare deploy --skip-build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
