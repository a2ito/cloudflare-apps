/**
 * wrangler.jsonc の雛形。実 ID と公開ホスト名を含む wrangler.jsonc は追跡しない。
 * `npm run cf:config` で環境変数 D1_DATABASE_ID / APP_HOSTNAME を埋めて生成する。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warikan",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "__APP_HOSTNAME__",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "warikan-db",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
