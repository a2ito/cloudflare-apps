# wifi-monitor エージェントの設定。~/.config/wifi-monitor/agent.env にコピーして埋める。
# トークンが入るので、自分だけが読めるようにしておく（chmod 600）。

# wifi-monitor の URL と、端末を登録したときに表示されたトークン（必須）
WIFI_MONITOR_URL=https://wifi-monitor.a2ito.work
WIFI_MONITOR_TOKEN=

# 以下は省略できる（空欄なら既定値）

# 計測の間隔（秒）。既定 60
WIFI_MONITOR_INTERVAL_SECONDS=
# 遅延・パケット損失を計る ping の宛先と回数。既定 1.1.1.1、5 回
WIFI_MONITOR_PING_HOST=
WIFI_MONITOR_PING_COUNT=
# ダウンロード速度を計る間隔（分）と落とす量（バイト）。既定 60 分・10000000（1 日約 240MB）。0 分なら計らない
WIFI_MONITOR_SPEED_INTERVAL_MINUTES=
WIFI_MONITOR_SPEED_BYTES=
# Wi-Fi のインタフェース名（en0、wlan0 など）。既定は自動で探す
WIFI_MONITOR_INTERFACE=
# 送れなかった計測を貯めるファイル。既定は macOS が ~/Library/Application Support/wifi-monitor/queue.jsonl、
# Linux が ~/.local/state/wifi-monitor/queue.jsonl
WIFI_MONITOR_QUEUE_FILE=
